{
  "name": "material-map",
  "version": "1.0.0",
  "description": "A local-first personal material map desktop app",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mcp": "esbuild scripts/material-map-mcp.ts --bundle --platform=node --format=cjs --packages=external --external:sqlite-vec --external:electron --external:@aws-sdk/client-s3 --outfile=out/material-map-mcp.cjs",
    "mcp": "npm run build:mcp && node out/material-map-mcp.cjs",
    "package": "npm run package:win",
    "package:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "preview": "electron-vite preview",
    "test": "vitest run src/main src/renderer/src",
    "test:ci": "vitest run src/main src/renderer/src --exclude src/main/workspace-stress.test.ts --exclude src/main/demo-service.test.ts --testTimeout=30000 --hookTimeout=30000",
    "test:e2e": "npm run build && vitest run src/e2e",
    "benchmark": "esbuild scripts/benchmark.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/benchmark.cjs && node node_modules/.cache/benchmark.cjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.2",
    "archiver": "latest",
    "chokidar": "^5.0.0",
    "electron-vite": "latest",
    "highlight.js": "^11.11.1",
    "lucide-react": "latest",
    "mammoth": "latest",
    "papaparse": "^5.5.4",
    "pdf-parse": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sqlite-vec": "^0.1.9",
    "unzipper": "latest"
  },
  "devDependencies": {
    "@types/archiver": "latest",
    "@types/dagre": "^0.7.54",
    "@types/node": "latest",
    "@types/papaparse": "^5.5.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/unzipper": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "typescript": "latest",
    "vite": "^7.3.6",
    "vitest": "latest"
  },
  "build": {
    "appId": "com.materialmap.desktop",
    "productName": "Material Map",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
