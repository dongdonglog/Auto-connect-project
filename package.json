{
  "name": "material-map",
  "version": "0.1.0",
  "description": "A local-first personal material map desktop app",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder --win nsis portable",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.2",
    "archiver": "latest",
    "electron-vite": "latest",
    "highlight.js": "^11.11.1",
    "lucide-react": "latest",
    "mammoth": "latest",
    "papaparse": "^5.5.4",
    "pdf-parse": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "latest",
    "unzipper": "latest"
  },
  "devDependencies": {
    "@types/archiver": "latest",
    "@types/dagre": "^0.7.54",
    "@types/node": "latest",
    "@types/papaparse": "^5.5.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sql.js": "latest",
    "@types/unzipper": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "vite": "^7.3.6",
    "vitest": "latest"
  },
  "build": {
    "appId": "com.materialmap.desktop",
    "productName": "Material Map",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
