{
  "name": "material-map",
  "version": "0.1.0",
  "description": "A local-first personal material map desktop app",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder --win nsis portable",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "latest",
    "electron-vite": "latest",
    "lucide-react": "latest",
    "mammoth": "latest",
    "pdf-parse": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sql.js": "latest",
    "unzipper": "latest"
  },
  "devDependencies": {
    "@types/archiver": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sql.js": "latest",
    "@types/unzipper": "latest",
    "electron-builder": "^26.15.3",
    "electron": "latest",
    "typescript": "latest",
    "vite": "^7.3.6",
    "vitest": "latest"
  },
  "build": {
    "appId": "com.materialmap.desktop",
    "productName": "Material Map",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
